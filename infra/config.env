# Non-secret defaults for the CircleGuard AWS bootstrap. Override with env vars.
# Never put credentials or key material in this file.
AWS_REGION="${AWS_REGION:-us-east-1}"
PROJECT="${PROJECT:-circleguard}"
KEY_NAME="${KEY_NAME:-circleguard-key}"
KEY_DIR="${KEY_DIR:-$HOME/.ssh}"
# Ubuntu Server 24.04 LTS, resolved at runtime from the public SSM parameter
AMI_SSM_PARAM="/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"

# name:type:disk_gb:swap_gb  (type/size are estimates, see infra/docs/costs.md)
SERVERS=(
  "jenkins:t3.medium:30:2"
  "sonarqube:t3.medium:30:4"
  "nexus:t3.medium:50:2"
  "dev:t3.medium:30:4"
  "stage:t3.medium:30:4"
  "prod:t3.medium:30:4"
)
# Logical groups -> security groups
CICD_SERVERS=(jenkins sonarqube nexus)
ENV_SERVERS=(dev stage prod)
