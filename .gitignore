# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Node/Expo (Handled in mobile/ but good to have here too)
node_modules/
.expo/
dist/
web-build/

# Docker Local Data
*_data/
pgdata/
neo4jdata/

# Cloud credentials and key material (never commit)
*.pem
*.ppk
.aws/
infra/.env

# HU-01: local Python bootstrap/test caches
__pycache__/
*.pyc

# Generated TLS private keys and local certificate authority are never versioned.
infra/k8s/tls/.private/
# Temporary scanner reports can contain sensitive matches.
ci/.secret-scan.*

# HU-13: generated security reports, caches and downloaded local tools
ci/reports/trivy/
ci/.trivy-cache/
ci/.tools/

# HU-21: Locust and ZAP reports generated by the pipeline
ci/reports/performance/
ci/reports/zap/

# HU-02: private per-environment configuration
infra/environments/.env.*
!infra/environments/.env.example

# Terraform private backend configuration
**/backend.hcl

# Terraform private variables and execution plans
**/terraform.tfvars
*.tfplan
# HU-17: Alertmanager secrets directory
.alertmanager-secrets/
