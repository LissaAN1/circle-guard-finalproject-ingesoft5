# Prevents Lombok from looking for config files further up the directory tree.
config.stopBubbling = true

# Annotates every Lombok-generated method/class with @lombok.Generated so that
# JaCoCo and SonarQube automatically exclude generated code (equals, hashCode,
# toString, canEqual, builder setters, etc.) from coverage metrics.
# Without this, Lombok-generated branches inflate the uncovered-branch count
# and cause the 60% quality gate to fail even when business logic is well tested.
lombok.addLombokGeneratedAnnotation = true
