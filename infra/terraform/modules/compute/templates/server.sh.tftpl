#!/bin/bash
# k3s server bootstrap (rendered by Terraform). Runs once as cloud-init user data.
set -euo pipefail

snap install aws-cli --classic

TOKEN="$(aws ssm get-parameter --region ${region} --name ${token_parameter} \
  --with-decryption --query Parameter.Value --output text)"
%{ if registry.endpoint != "" ~}

# Private registry for containerd (k3s reads this file at start). The password is read
# from SSM and written with mode 0600; it is never part of the user data.
REG_PASSWORD="$(aws ssm get-parameter --region ${region} --name ${registry.password_parameter} \
  --with-decryption --query Parameter.Value --output text)"
# YAML single-quoted scalar: the only character to escape is the single quote (doubled).
SQ="'"
REG_PASSWORD_YAML="$${REG_PASSWORD//$SQ/$SQ$SQ}"
mkdir -p /etc/rancher/k3s
umask 077
cat > /etc/rancher/k3s/registries.yaml <<EOF_REGISTRIES
mirrors:
  "${registry.endpoint}":
    endpoint:
      - "http://${registry.endpoint}"
configs:
  "${registry.endpoint}":
    auth:
      username: "${registry.username}"
      password: '$REG_PASSWORD_YAML'
EOF_REGISTRIES
umask 022
unset REG_PASSWORD REG_PASSWORD_YAML
%{ endif ~}

# The public IP is added to the API certificate so kubectl works from the operator machine.
IMDS_TOKEN="$(curl -s -X PUT http://169.254.169.254/latest/api/token \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
PUBLIC_IP="$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/public-ipv4)"

curl -sfL https://get.k3s.io | \
  INSTALL_K3S_VERSION='${k3s_version}' K3S_TOKEN="$TOKEN" \
  sh -s - server --write-kubeconfig-mode 640 --tls-san "$PUBLIC_IP"
