// HU-09: parametrized rollback job. Redeploys a specific image version on the chosen environment.
// Prerequisites:
//   - ec2-ssh-key credential (SSH Username with private key, user ubuntu) configured in Jenkins.
//   - EC2_DEV_HOST / EC2_STAGE_HOST / EC2_PROD_HOST set in Jenkins global env,
//     OR provide TARGET_HOST explicitly when triggering the job.
@Library('circleguard-ci') _

pipeline {
    agent { label 'docker' }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'prod'],
            description: 'Environment to roll back'
        )
        string(
            name: 'APP_VERSION',
            defaultValue: '',
            description: 'Version tag to redeploy, e.g. 1.0.0 or 1.0.0-ci.12.ab12cd3'
        )
        string(
            name: 'TARGET_HOST',
            defaultValue: '',
            description: 'EC2 public IP (leave blank to use the EC2_<ENV>_HOST global env var)'
        )
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (!params.APP_VERSION?.trim()) {
                        error 'APP_VERSION is required'
                    }
                    String envName = params.ENVIRONMENT
                    String host    = params.TARGET_HOST?.trim() ?: env["EC2_${envName.toUpperCase()}_HOST"]?.trim()
                    if (!host) {
                        error "No target host: set EC2_${envName.toUpperCase()}_HOST in Jenkins global env or provide TARGET_HOST"
                    }
                    env.CG_ROLLBACK_HOST = host
                    echo "Rollback: environment=${params.ENVIRONMENT}, version=${params.APP_VERSION}, host=${host}"
                }
            }
        }

        stage('Rollback') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ec2-ssh-key',
                                                   keyFileVariable: 'SSH_KEY',
                                                   usernameVariable: 'SSH_USER')]) {
                    sh(label: 'upload-rollback-script', script: """
                        scp -o StrictHostKeyChecking=accept-new -o BatchMode=yes \\
                          -i "\${SSH_KEY}" \\
                          ci/rollback/rollback-remote.sh \\
                          "\${SSH_USER}@\${CG_ROLLBACK_HOST}:/tmp/cg-rollback-remote.sh"
                    """)
                    sh(label: 'run-rollback', script: """
                        ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes \\
                          -i "\${SSH_KEY}" \\
                          "\${SSH_USER}@\${CG_ROLLBACK_HOST}" \\
                          "bash /tmp/cg-rollback-remote.sh '${params.ENVIRONMENT}' '${params.APP_VERSION}'; rm -f /tmp/cg-rollback-remote.sh"
                    """)
                }
            }
        }
    }

    post {
        success {
            echo "Rollback ${params.ENVIRONMENT} -> ${params.APP_VERSION}: OK. Record in Jira per TEC-06."
        }
        failure {
            cgNotify('FAILURE')
        }
    }
}
